source 'https://rubygems.org'

# Only the plugins the site actually uses. jekyll-feed and jemoji were
# dropped with the blog; gems in this group load regardless of _config.yml.
group :jekyll_plugins do
  gem 'jekyll'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'webrick', '~> 1.8'
end

gem 'github-pages'
gem 'connection_pool', '2.5.0'
